{
    "image": "mcr.microsoft.com/devcontainers/universal:2",
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-containers"
            ]
        }
    },
    "postCreateCommand": [
        "bash",
        "-c",
        "mkdir -p ./dags ./logs ./plugins && if [ ! -f .env ]; then echo \"AIRFLOW_UID=$(id -u)\" > .env; fi"
  ]
}
